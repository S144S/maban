MABAN_ENVIRONMENT=local
MABAN_DATABASE_URL=postgresql+psycopg://maban:maban_local@127.0.0.1:54339/maban
MABAN_SECRET_KEY=local-only-change-before-deployment-1234567890
MABAN_ALLOWED_ORIGINS=["http://127.0.0.1:6201","http://localhost:6201"]
# Private plant photo storage (Docker Compose local credentials only).
MABAN_MINIO_ENDPOINT=127.0.0.1:54340
MABAN_MINIO_ACCESS_KEY=maban_local
MABAN_MINIO_SECRET_KEY=maban_minio_local_only
MABAN_MINIO_BUCKET=maban-plants
MABAN_MINIO_SECURE=false
# Initialize once: uv run python -m app.plants.storage
# Production: private bucket, dedicated scoped credentials, TLS, external backups.
# Production requires HTTPS origins, a random secret (32+ chars), secure cookies,
# and an IranPayamak OTP pattern with a `code` attribute.
# MABAN_ENVIRONMENT=production
# MABAN_COOKIE_SECURE=true
# MABAN_SMS_API_KEY=
# MABAN_SMS_TEMPLATE=
# Production OTP delivery requires: uv run python -m app.sms_worker
# API and worker must share DATABASE_URL, SECRET_KEY and SMS settings.
# OTP payloads in the queue are encrypted with a key derived from SECRET_KEY.

# Required in production: SMS_TEMPLATE is the IranPayamak pattern code.
# MABAN_SMS_LINE_NUMBER=30001234

# Reminder delivery stays disabled until its separate approved pattern is ready.
# Pattern attributes: title, date (Jalali YYYY/MM/DD), time (Tehran HH:MM),
# amount (whole tomans, or the Persian text for no amount).
MABAN_REMINDER_SMS_ENABLED=false
# MABAN_SMS_REMINDER_TEMPLATE=
# Required positive whole-toman tariff before enabling reminder delivery; set your actual price.
MABAN_SMS_PRICE_TOMAN=0
# Optional Zarinpal merchant; both settings are required together. Use HTTPS in production.
# MABAN_PAYMENT_MERCHANT_ID=
# MABAN_PAYMENT_CALLBACK_URL=https://api.example.com/api/wallet/callback
# The first ALLOWED_ORIGINS entry receives /wallet callback redirects.
